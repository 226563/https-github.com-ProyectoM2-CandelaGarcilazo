# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=miniblog
# PGUSER=postgres
# PGPASSWORD=tu_contraseña_local

PORT= Aquí va el puerto en el que quieres que tu aplicación se ejecute, por ejemplo: 3000
DATABASE_URL= Aquí va tu URL de conexión a la base de datos en Render, por ejemplo: postgresql://usuario:contraseña@host:puerto/base_de_datos